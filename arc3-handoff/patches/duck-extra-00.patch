+# --- ARC3 Duck (petersharps): solved-level notes and stuck audit -------------
+# All default off. ARC3_LEVEL_NOTES: after a level is solved the model is asked
+# for a short "LEVEL k NOTES:" paragraph; whenever old history is evicted the
+# collected notes are restated at the end of the system prompt. An eviction
+# already invalidates the cached prefix right after the system prompt, so this
+# costs almost nothing, and the notes survive the 118k -> 59k drains that
+# otherwise erase what earlier levels taught.
+# ARC3_STUCK_AUDIT_TOKENS: once this many tokens were generated on the current
+# level (and at every further multiple), the next opener asks for a short
+# strategy audit before more actions are spent.
+_LEVEL_NOTES_RE = re.compile(
+    r"LEVEL[ \t]*(\d+)[ \t]*NOTES?[ \t]*:[ \t]*(.+?)(?=\n[ \t]*\n|LEVEL[ \t]*\d+[ \t]*NOTES?[ \t]*:|\Z)",
+    re.S | re.I,
+)
+_LEVEL_NOTES_ECHO_MARKERS = ("at most 4 short sentences", "the harness keeps these notes")
+
+
+def _level_notes_enabled() -> bool:
+    return _get_env_bool("ARC3_LEVEL_NOTES", False)
+
+
+def _level_notes_max_chars() -> int:
+    return max(120, _get_env_int("ARC3_LEVEL_NOTES_MAX_CHARS", 600))
+
+
+def _stuck_audit_tokens() -> int:
+    return max(0, _get_env_int("ARC3_STUCK_AUDIT_TOKENS", 0))
+
+
+def _level_notes_message_texts(message: dict[str, Any]) -> list[str]:
+    """Reasoning first, visible content last, so content wins on duplicates."""
+    out: list[str] = []
+    for key in ("reasoning", "reasoning_content", "content"):
+        value = message.get(key)
+        if isinstance(value, str):
+            out.append(value)
+        elif isinstance(value, list):
+            for part in value:
+                if isinstance(part, dict) and isinstance(part.get("text"), str):
+                    out.append(part["text"])
+    return out
+
+
+def _extract_level_notes(messages: list[dict[str, Any]]) -> dict[int, str]:
+    found: dict[int, str] = {}
+    limit = _level_notes_max_chars()
+    for message in messages:
+        if str(message.get("role", "")).strip() != "assistant":
+            continue
+        for text in _level_notes_message_texts(message):
+            if "NOTE" not in text.upper():
+                continue
+            for match in _LEVEL_NOTES_RE.finditer(text):
+                note = " ".join(match.group(2).replace("`", " ").split())
+                lowered = note.lower()
+                if len(note) < 20 or any(m in lowered for m in _LEVEL_NOTES_ECHO_MARKERS):
+                    continue
+                try:
+                    level = int(match.group(1))
+                except ValueError:
+                    continue
+                if 0 < level < 100:
+                    found[level] = note[:limit]
+    return found
+
+
+def _level_notes_request(completed_level: int) -> str:
+    return (
+        f"Level {completed_level} is solved. In your next reply, write one short paragraph "
+        f"that starts with `LEVEL {completed_level} NOTES:` and states the mechanics you "
+        "verified, the win condition, and the action pattern that solved it (at most 4 short "
+        "sentences). The harness keeps these notes for the rest of the game, even after "
+        "older history is trimmed."
+    )
+
+
+def _stuck_audit_prompt(level: int, spent_tokens: int) -> str:
+    return (
+        f"STRATEGY AUDIT: about {spent_tokens // 1000}k tokens have been spent on level "
+        f"{level} without solving it. Before spending more actions, step back in at most "
+        "6 short lines: (1) which hypotheses about the goal and mechanics you have tested "
+        "and which were falsified, (2) which board elements, colors or actions you have NOT "
+        "yet interacted with, (3) whether the goal might be different from what you assumed. "
+        "Then run the single cheapest experiment that best distinguishes the remaining "
+        "hypotheses."
+    )
+
+
