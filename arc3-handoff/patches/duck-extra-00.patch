+    def _arc3_level_notes_block(self) -> str:
+        notes = getattr(self, "_arc3_level_notes", {}) or {}
+        if not notes:
+            return ""
+        actions = getattr(self, "_arc3_level_actions", {}) or {}
+        rows = []
+        for level in sorted(notes)[-8:]:
+            spent = actions.get(level)
+            label = f"Level {level}" + (f" (solved in about {spent} actions)" if spent else "")
+            rows.append(f"- {label}: {notes[level]}")
+        return (
+            "## Notes from levels you already solved\n"
+            "Older conversation history was trimmed to fit the context window. You wrote these "
+            "notes right after solving each level; they are kept for the whole game. Treat them "
+            "as mechanics that held on earlier levels and verify them on the current board.\n"
+            + "\n".join(rows)
+        )
+
+    def _arc3_refresh_level_notes(
+        self, old_history: list[dict[str, Any]], system_message: dict[str, Any]
+    ) -> dict[str, Any]:
+        """Collect notes from the pre-eviction history and restate them in the
+        system prompt. Never raises: a failure here must not cost a turn."""
+        try:
+            self._arc3_level_notes.update(_extract_level_notes(old_history))
+            base = getattr(self, "_arc3_base_system_prompt", "") or ""
+            content = system_message.get("content")
+            if not base or not isinstance(content, str) or not content.startswith(base):
+                return system_message
+            block = self._arc3_level_notes_block()
+            new_prompt = base + ("\n\n" + block if block else "")
+            self._system_prompt = new_prompt
+            if content == new_prompt:
+                return system_message
+            updated = dict(system_message)
+            updated["content"] = new_prompt
+            return updated
+        except Exception as exc:  # noqa: BLE001
+            log.warning("ARC3 level notes refresh failed: %s", exc)
+            return system_message
+
